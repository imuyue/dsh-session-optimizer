# Tarball URLs in package-lock.json name the public registry. npm rewrites that
# host to whatever `registry` points at (this is `replace-registry-host=npmjs`,
# also the default), so a mirror still installs from the mirror and its CDN.
#
# Leaving them pointing at a third-party registry instead is what broke
# `npm ci` under npm 12: that release defaults to `allow-remote=none` and
# refuses to fetch any tarball whose host is not the configured registry.
replace-registry-host=npmjs
