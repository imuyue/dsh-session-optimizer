{
  "name": "dsh-session-optimizer",
  "version": "0.1.29",
  "description": "SQLite session backend for DSH: one database per conversation, with window reads, zstd chunking, migration and an inspection console.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "dsh-session-optimizer": "lib/cli.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cli": {
      "types": "./lib/cli.d.ts",
      "default": "./lib/cli.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imuyue/dsh-session-optimizer.git"
  },
  "bugs": {
    "url": "https://github.com/imuyue/dsh-session-optimizer/issues"
  },
  "homepage": "https://github.com/imuyue/dsh-session-optimizer#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "session",
    "sqlite",
    "persistence",
    "zstd"
  ],
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "build:host": "tsc -p tsconfig.json",
    "build:client": "node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-session-persistence": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-session-query": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-app-boot": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-session-persistence-jsonl": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/node-addon-system": "0.1.2",
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-persistence": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.2-rc.1",
    "@deepseek-ai/node-addon-system": "0.1.2",
    "@deepseek-ai/schemastery": "3.19.0",
    "@types/node": "^24.10.1",
    "rolldown": "^1.2.16",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "@deepseek-ai/dsh-session-query": "0.2.2-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-session-query": {
      "optional": true
    }
  }
}
